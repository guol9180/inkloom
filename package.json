{
  "name": "inkloom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Markdown-native, file-first knowledge workspace for text and diagrams.",
  "license": "MIT",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @inkloom/web dev",
    "dev:api": "pnpm --filter @inkloom/api dev",
    "build": "pnpm --filter @inkloom/web build && pnpm --filter @inkloom/api build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "oxlint --deny-warnings .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "preview:web": "node apps/web/serve.mjs",
    "start:api": "pnpm --filter @inkloom/api start",
    "verify:production": "node deploy/verify-production.mjs"
  }
}

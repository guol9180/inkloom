VITE_APP_ORIGIN=https://inkloom.imhgl.com
VITE_API_ORIGIN=https://api.inkloom.imhgl.com
VITE_COLLAB_ORIGIN=wss://sync.inkloom.imhgl.com
VITE_ASSET_ORIGIN=https://cdn.inkloom.imhgl.com

# Server-only: never expose these through VITE_ variables.
PORT=3001
INKLOOM_DATABASE_PATH=/srv/inkloom/data/inkloom.sqlite
INKLOOM_ASSET_DIR=/srv/inkloom/data/assets
INKLOOM_MAX_ASSET_BYTES=52428800
INKLOOM_WEB_ORIGINS=https://inkloom.imhgl.com
INKLOOM_TRUST_PROXY=true
INKLOOM_AUTH_WINDOW_SECONDS=600
INKLOOM_AUTH_IP_ATTEMPTS=30
INKLOOM_AUTH_ACCOUNT_ATTEMPTS=10
INKLOOM_PASSWORD_CONCURRENCY=4
